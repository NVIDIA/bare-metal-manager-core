# syntax=docker/dockerfile:1.7
#
# Cross-build carbide-api for linux/amd64 from any build host, following the
# same approach as crates/machine-a-tron/Dockerfile: the builder runs NATIVE on
# $BUILDPLATFORM and cross-compiles to x86_64-unknown-linux-gnu. Building the
# amd64 stage under QEMU instead segfaults assembling aws-lc-sys' hand-written
# x86-64 assembly.
#
# Used to produce diagnostic images when the in-cluster builder has no network
# (dev6's CoreDNS degrades at ~13.5k Services, leaving builder pods unable to
# resolve crates.io or the Debian mirrors).
#
#   docker buildx build --platform linux/amd64 \
#     -f dev/docker/Dockerfile.api-crossbuild \
#     --build-arg BASE=<image to overlay> -t <tag> --push .

ARG RUST_VERSION=1.96.0
ARG BASE=nvcr.io/0837451325059433/carbide-dev/nvmetal-carbide:v2.1.0-pr-614-g587165fcf-lockfix4

FROM --platform=$BUILDPLATFORM rust:${RUST_VERSION}-bookworm AS builder

ARG VERSION
ARG CI_COMMIT_SHORT_SHA
ENV VERSION=${VERSION}
ENV CI_COMMIT_SHORT_SHA=${CI_COMMIT_SHORT_SHA}

# amd64 as a foreign architecture so the -sys crates can link cross-built
# system libraries rather than the host's aarch64 ones.
RUN dpkg --add-architecture amd64 \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        git pkg-config protobuf-compiler libprotobuf-dev cmake clang lld unzip curl \
    && if [ "$(uname -m)" != "x86_64" ]; then \
         apt-get install -y --no-install-recommends \
           gcc-x86-64-linux-gnu g++-x86-64-linux-gnu libc6-dev-amd64-cross \
           libssl-dev:amd64 libudev-dev:amd64 libtss2-dev:amd64; \
       else \
         apt-get install -y --no-install-recommends \
           gcc g++ libc6-dev libssl-dev libudev-dev libtss2-dev; \
       fi \
    && rm -rf /var/lib/apt/lists/*

RUN rustup target add x86_64-unknown-linux-gnu

ENV CARGO_HOME=/cargo-home
ENV CARGO_NET_GIT_FETCH_WITH_CLI=true
ENV CARGO_TARGET_DIR=/cargo-target
ENV RUST_BACKTRACE=1

WORKDIR /workspace
COPY . .

RUN --mount=type=cache,id=nico-api-cross-cargo-home,target=/cargo-home,sharing=locked \
    --mount=type=cache,id=nico-api-cross-cargo-target,target=/cargo-target,sharing=locked \
    set -e; \
    if [ ! -d .git ]; then \
      git init -q && git config user.email b@l && git config user.name b \
        && git add -A -f >/dev/null 2>&1 && git commit -qm snap; \
    fi; \
    if [ "$(uname -m)" != "x86_64" ]; then \
      export CARGO_TARGET_X86_64_UNKNOWN_LINUX_GNU_LINKER=x86_64-linux-gnu-gcc \
             CC_x86_64_unknown_linux_gnu=x86_64-linux-gnu-gcc \
             CXX_x86_64_unknown_linux_gnu=x86_64-linux-gnu-g++ \
             PKG_CONFIG_ALLOW_CROSS=1 \
             PKG_CONFIG_PATH=/usr/lib/x86_64-linux-gnu/pkgconfig; \
    fi; \
    cargo build --bin carbide-api --release --target x86_64-unknown-linux-gnu; \
    mkdir -p /artifacts; \
    cp /cargo-target/x86_64-unknown-linux-gnu/release/carbide-api /artifacts/carbide-api; \
    strings /artifacts/carbide-api | grep -q 'admin reconcile skipped without taking segment locks' \
      || { echo 'FAST PATH STRING MISSING - refusing to ship'; exit 1; }

FROM ${BASE}
COPY --from=builder /artifacts/carbide-api /opt/carbide/carbide-api

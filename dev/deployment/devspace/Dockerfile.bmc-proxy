FROM build-container-localdev AS builder

# Route Cargo crate downloads through squid proxy.
# Pass at build time: docker build --build-arg SQUID_PROXY=http://172.16.0.50:3128
ARG SQUID_PROXY
ENV http_proxy=${SQUID_PROXY} \
    https_proxy=${SQUID_PROXY} \
    HTTP_PROXY=${SQUID_PROXY} \
    HTTPS_PROXY=${SQUID_PROXY}

ENV CARGO_HOME=/cargo-home
ENV CARGO_NET_GIT_FETCH_WITH_CLI=true
ENV CARGO_TARGET_DIR=/cargo-target

WORKDIR /workspace

COPY . .

RUN --mount=type=cache,id=nico-devspace-cargo-home,target=/cargo-home,sharing=locked \
  --mount=type=cache,id=nico-devspace-cargo-target,target=/cargo-target,sharing=locked \
  cargo build -p carbide-bmc-proxy --bin carbide-bmc-proxy && \
  mkdir -p /artifacts && \
  cp /cargo-target/debug/carbide-bmc-proxy /artifacts/carbide-bmc-proxy

ENV http_proxy= https_proxy= HTTP_PROXY= HTTPS_PROXY=

FROM ubuntu:24.04

# Pass proxy only to apt RUN via shell — never bake into ENV to avoid
# leaking proxy settings into the running container environment.
ARG SQUID_PROXY
RUN http_proxy=${SQUID_PROXY} https_proxy=${SQUID_PROXY} \
    apt-get update && \
    http_proxy=${SQUID_PROXY} https_proxy=${SQUID_PROXY} \
    apt-get install -y --no-install-recommends \
      ca-certificates \
      curl \
      ipmitool \
      iproute2 \
      iputils-ping \
      libudev1 \
      tpm2-tools \
    && rm -rf /var/lib/apt/lists/*

RUN mkdir -p /opt/carbide /mnt/persistence

COPY --from=builder /artifacts/carbide-bmc-proxy /opt/carbide/carbide-bmc-proxy

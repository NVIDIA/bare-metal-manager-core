# if carbide_static_pxe_url is configured in the environment, static_pxe_url
# will use that url. Otherwise, carbide_static_pxe_url will be the same as carbide_pxe_url.

set base-url {{ static_pxe_url }}/public/blobs/
# One cloud-init URL per consumer. Each points at its own route prefix, so the
# prefix a machine boots with is what identifies it and the service never has to
# work out who is calling from data that cannot cleanly tell them apart.
set tenant-cloudinit-url {{ pxe_url }}/api/v0/cloud-init/tenant/
set dpu-cloudinit-url {{ pxe_url }}/api/v0/cloud-init/dpu/
set scout-cloudinit-url {{ pxe_url }}/api/v0/cloud-init/scout/

# DEPRECATED: use tenant-cloudinit-url instead. This is the original name, from
# when there was one cloud-init URL for everyone, and tenant-authored ipxeScript
# values in the wild still reference it -- so it keeps working, and keeps
# meaning the tenant seed, rather than being repointed or removed underneath
# them. It will be deleted once those scripts have had time to move over; see
# docs/provisioning/ipxe-script-variables.md. Nothing NICo ships should use it.
set cloudinit-url ${tenant-cloudinit-url}

{{ ipxe }}

